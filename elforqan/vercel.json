{
    "headers": [
        {
            "source": "/(.*\\.(?:jpg|jpeg|png|svg|webp|ico|woff2|css|js|mp3))",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}
